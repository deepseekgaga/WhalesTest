{
  "manifest_version": 3,
  "key": "",
  "name": "CC 批量下载与 TXT 汇总",
  "version": "0.1.0",
  "description": "在授权测试环境中按 Excel 顺序下载 ZIP 并汇总 TXT 字段。",
  "permissions": ["nativeMessaging", "tabs", "downloads", "storage", "activeTab", "scripting"],
  "action": {
    "default_title": "执行 CC 批量任务",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
