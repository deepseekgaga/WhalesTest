{
  "manifest_version": 3,
  "key": "",
  "name": "授权登录与 MFA 测试工作流",
  "version": "0.1.0",
  "description": "用于授权隔离环境中的登录、TOTP 与短信双因素验证流程测试。",
  "permissions": ["nativeMessaging", "tabs", "downloads", "storage", "activeTab", "scripting", "alarms"],
  "host_permissions": [
    "http://127.0.0.1:9527/*",
    "http://auth-target.local/*",
    "http://totp-lab.local/*",
    "http://sms-lab.local/*"
  ],
  "incognito": "spanning",
  "action": {
    "default_title": "执行授权登录测试工作流",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
