{
  "manifest_version": 3,
  "key": "",
  "name": "Whalestest 双阶段授权测试工具",
  "version": "0.1.0",
  "description": "在授权隔离环境中运行 CC 数据处理和登录 MFA 流程测试。",
  "permissions": ["nativeMessaging", "tabs", "downloads", "storage", "activeTab", "scripting", "alarms"],
  "host_permissions": [
    "https://api.bridgefloods.com/*",
    "http://auth-target.local/*",
    "http://totp-lab.local/*",
    "http://sms-lab.local/*"
  ],
  "incognito": "spanning",
  "action": {
    "default_title": "打开 Whalestest 双阶段测试工具",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
